# ----- Lunara / Luna Radio environment -----

# Server
PORT=8080

# 伙伴的 LLM endpoint 不再从 .env 读取。
# 请在启动浮层填写 Base URL / API Key / Model；默认保存到 ~/.lunara/config.json。
# 可覆盖配置目录（主要供测试或便携运行）：
# LUNARA_CONFIG_DIR=/path/to/private-config
LLM_TIMEOUT_MS=90000
VIRTUAL_PERSON_TURN_TIMEOUT_MS=120000
CONVERSATION_CONTEXT_MAX_BYTES=48000
CONVERSATION_CONTEXT_MAX_MESSAGES=32
CONVERSATION_TOOL_RESULT_MAX_BYTES=4000
# 临时副本验收时可指定数据库和角色目录：
# LUNARA_DB_PATH=/path/to/state.db
# LUNARA_RADIOHOST_DIR=/path/to/radiohost
#
# 数据根（add-cli-launch-data-dir）：所有运行期状态默认存 ~/.lunara，
# 可用 LUNARA_DATA_DIR（或 lunara --data-dir）整体覆盖。
# 优先级：LUNARA_DB_PATH / LUNARA_RADIOHOST_DIR / LUNARA_TTS_* 等每路径变量
#   > LUNARA_DATA_DIR 推导 > 默认 ~/.lunara。
# 任一覆盖变量存在即视为显式/开发场景：首启动自动迁移与旧布局自动隔离跳过。
# 相对路径相对【数据根】解析（不再相对当前目录），启动时会告警实际解析路径。
# 密钥目录与数据根解耦：config.json / tts-custom.json 恒在 ~/.lunara（或 LUNARA_CONFIG_DIR），
# 不随 LUNARA_DATA_DIR 移动。
# LUNARA_DATA_DIR=/path/to/data-root

# DeepSeek（推荐：便宜很快，国内访问稳）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# MiniMax（chatcompletion_v2）
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimaxi.com   # 国际站可改为 https://api.minimax.io
# 同一 API key 用于当前 MiniMax TTS；音色可在创建伙伴时选择
MINIMAX_VOICE_ID=Chinese (Mandarin)_Sweet_Lady

# NeteaseCloudMusicApi —— 默认由主程序在进程内启动，无需另开终端。
# 留空或指向 loopback：启动内置服务（已有实例则复用，端口冲突时自动换空闲端口）。
# 指向远端主机：当作你自管的外部服务。
NCM_BASE_URL=http://127.0.0.1:3000
NCM_COOKIE=
# 设为 0 可关闭内置启动，改为自行管理网易云进程
LUNARA_EMBEDDED_NCM=1

# QQ Music SDK 已内置，无需端口或独立服务。登录默认使用应用内扫码。
# Cookie 不写入 .env；在 Lunara 登录面板使用 QQ App 扫码即可。

# macOS 无 MiniMax key 时会回退到系统 say
TTS_SAY_VOICE=Ting-Ting

# Weather (Open-Meteo, no key needed) — set your coords
WEATHER_LAT=31.2304
WEATHER_LON=121.4737

# Local timezone & display name
TZ=Asia/Shanghai
USER_DISPLAY_NAME=你

# UPnP / Naim renderer (optional, leave empty to skip)
NAIM_RENDERER_URL=

# ===== 角色反思与共享记忆 =====

REFLECTION_AGENT_DISABLED=         # 设 1 关闭整个反思 agent
REFLECTION_SHORT_WINDOW=5          # 短窗触发阈值
REFLECTION_LLM_TIMEOUT_MS=15000    # 后台请求超时并取消；失败保留观察，最多自动尝试 3 次
REFLECTION_LONG_AUTO=              # 设 1 启用每天 08:00 长窗自动反思

# ===== 记忆系统 v2（memory-system-v2 change）=====
# StationDreaming 随应用启动并每小时补偿处理已有反思；不单独调用模型。

# 调度灰度开关，默认 OFF；跑稳后翻 1 开自动
MEMORY_CONSOLIDATION_AUTO=         # 设 1 启用每小时整理个人记忆（不等同共享偏好晋升）
MEMORY_SUMMARY_AUTO=               # 设 1 启用每日 23:00 + 每周日 23:30 summary

# 预热候选池
WARM_POOL_DISABLED=                # 设 1 整体禁用预热（紧急回滚）
WARM_POOL_INTERVAL_MIN=8           # 后台刷新间隔（分钟）

# ---- 歌曲结构化标签（song-structured-tags）----
# 打标模型跟随「设置 → 模型」的使用中模型（unified-model-providers），不再有独立端点 env。
SONG_TAG_AUTO=                     # 设 1：resolveTrack 命中新歌后自动异步打标（覆盖设置页的自动开关）
SONG_TAG_TTL_DAYS=30               # 标签过期天数，超期才重打
SONG_TAG_CONCURRENCY=1             # 打标队列并发上限（防 LLM storm）
CANDIDATE_MAX_PLAYLISTS=8
CANDIDATE_PLAYLIST_LIMIT=50
SONG_TAG_BACKFILL_CRON=0
SONG_TAG_BACKFILL_CRON_MIN=360
TASTE_SCHEMA_AUTO=1                 # 设 0：关闭每日口味图式自动蒸馏（默认开，每人每天一次）
REFLECTION_INJECT_LIMIT=3           # 注入对话的近期反思条数上限（默认 3，最大 10）
MUSIC_TASTE_SIGNALS_DISABLED=0      # 设 1：关闭口味 claim 对候选排序的同层偏置
MUSIC_PROBE_DISABLED=0             # 设 1：关闭"试歌"探查（钉头 + music_probes 落库）
MUSIC_PROBE_MIN_INTERVAL_MS=21600000  # 两次探查的最小间隔，默认 6 小时
